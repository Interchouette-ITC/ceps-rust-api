APP_ADDR=0.0.0.0
APP_PORT=8080
CEPS_RPC_URL=http://127.0.0.1:11101
CEPS_SSE_URL=http://127.0.0.1:18101/events
CEPS_CHAIN_NAME=casper-net-1
# SIGN_BACKEND: leave unset for none. Or: local | kms | none
# KMS_URL=http://127.0.0.1:4000
# LOCAL_KEYS_JSON is an env var (JSON text), not a path to a key file:
# LOCAL_KEYS_JSON={"01…":"<pem-string>"}
# Prefer map form public_key -> PEM string (e.g. NCTL user keys pasted into .env). Do not commit real key material.
# Live harness (tests only): CEPS_FAUCET_PEM or CEPS_FAUCET_PEM_PATH (+ optional CEPS_FAUCET_PUBLIC_KEY)
# Harness: create on KMS (KMS_URL) or set CEPS_FUND_TARGET, then fund FROM faucet PEM via SDK (not an API route)

